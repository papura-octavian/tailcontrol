<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows: testeaza si agentul (named pipes, ACL). CI ruleaza pe windows-latest. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Numele testelor au forma Metoda_Conditie_Rezultat; IAsyncLifetime face curatenia (CA1001). -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TailControl.Shared\TailControl.Shared.csproj" />
    <ProjectReference Include="..\..\src\TailControl.Shared.AspNetCore\TailControl.Shared.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\TailControl.Agent\TailControl.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
