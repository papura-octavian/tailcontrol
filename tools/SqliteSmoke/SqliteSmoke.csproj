<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Etapa 0: verifica faptul ca EF Core + SQLite (biblioteca nativa e_sqlite3)
    functioneaza pe Raspberry Pi 3B (linux-arm, 32 biti).
    Publicare: vezi README.md din acest folder.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Aceleasi setari de memorie pe care le va folosi Hub-ul pe Pi -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

</Project>
