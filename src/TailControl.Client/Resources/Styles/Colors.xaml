<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta TailControl. Fiecare culoare are varianta Light si Dark (folosite prin AppThemeBinding). -->

    <Color x:Key="BackgroundLight">#F4F6FA</Color>
    <Color x:Key="BackgroundDark">#0E1116</Color>

    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#181C23</Color>

    <Color x:Key="SurfaceAltLight">#EDF0F6</Color>
    <Color x:Key="SurfaceAltDark">#222833</Color>

    <Color x:Key="BorderLight">#E1E5EE</Color>
    <Color x:Key="BorderDark">#2A303B</Color>

    <Color x:Key="TextLight">#151922</Color>
    <Color x:Key="TextDark">#E9ECF2</Color>

    <Color x:Key="MutedLight">#5F6B7A</Color>
    <Color x:Key="MutedDark">#97A1B0</Color>

    <Color x:Key="PrimaryLight">#3557E8</Color>
    <Color x:Key="PrimaryDark">#7C96FF</Color>
    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#0E1116</Color>

    <Color x:Key="DangerLight">#D93636</Color>
    <Color x:Key="DangerDark">#FF7676</Color>

    <Color x:Key="WarningLight">#C77700</Color>
    <Color x:Key="WarningDark">#FFB547</Color>

    <Color x:Key="Online">#22C55E</Color>
    <Color x:Key="OfflineLight">#A3ABB8</Color>
    <Color x:Key="OfflineDark">#4E5664</Color>

    <Color x:Key="DisabledLight">#C9CED8</Color>
    <Color x:Key="DisabledDark">#363C48</Color>

    <SolidColorBrush x:Key="OnlineBrush" Color="{StaticResource Online}" />

</ResourceDictionary>
