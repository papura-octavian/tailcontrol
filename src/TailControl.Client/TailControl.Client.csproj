<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- v1: doar Android si Windows -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>TailControl.Client</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>TailControl</ApplicationTitle>
		<ApplicationId>io.github.papuraoctavian.tailcontrol</ApplicationId>

		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Windows unpackaged (installer Inno Setup, vezi docs) -->
		<WindowsPackageType>None</WindowsPackageType>

		<!-- Android 11+: BiometricPrompt cu amprenta SAU PIN-ul telefonului (BIOMETRIC_STRONG | DEVICE_CREDENTIAL). -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">30.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Pe Android iconita e cea de pe skipit.space (generata cu SkipIt-website/scripts/make-app-icons.mjs); Windows ramane cu cea originala. -->
		<MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" Include="Resources\AppIcon\Android\appicon.svg" ForegroundFile="Resources\AppIcon\Android\appiconfg.svg" ForegroundScale="0.65" />
		<MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#3557E8" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#3557E8" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="QRCoder" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TailControl.Client.Core\TailControl.Client.Core.csproj" />
	</ItemGroup>

</Project>
