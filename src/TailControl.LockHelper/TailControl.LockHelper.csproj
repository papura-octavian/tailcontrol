<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Helper fara fereastra, pornit la logare in sesiunea utilizatorului.
    Se conecteaza la pipe-ul agentului si apeleaza LockWorkStation cand primeste LOCK.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TailControl.Shared\TailControl.Shared.csproj" />
  </ItemGroup>

</Project>
